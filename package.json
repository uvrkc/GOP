{
  "name": "enterprise-team-hub",
  "version": "1.0.0",
  "description": "Enterprise Team Operations Hub - Desktop GUI for SSO, SharePoint Reports, and Push Notifications",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "server": "node server/server.js",
    "build:win": "electron-builder --win nsis"
  },
  "keywords": [
    "electron",
    "sso",
    "sharepoint",
    "microsoft-graph",
    "timesheet",
    "push-notifications",
    "line-manager"
  ],
  "author": "Enterprise Operations Team",
  "license": "ISC",
  "dependencies": {
    "@azure/msal-node": "^2.16.2",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "isomorphic-fetch": "^3.0.0",
    "node-cron": "^3.0.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.company.teamoperationshub",
    "productName": "Team Operations Hub",
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "directories": {
      "output": "dist"
    }
  }
}
